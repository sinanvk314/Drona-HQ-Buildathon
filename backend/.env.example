# Copy this file to .env and fill in as needed. Every value has a safe default —
# the backend runs with zero configuration in RULE engine mode.

# HTTP
PORT=8080
# Comma-separated list of origins allowed to call this API (your deployed/dev frontend).
ALLOWED_ORIGINS=http://localhost:5173

# Where the local JSON datastore lives (replaces the frontend's sessionStorage mock).
# Only used when DATABASE_URL below is NOT set.
DATA_FILE=./data/state.json

# Real Postgres (Neon) datastore. When set, this replaces the JSON file entirely — real tables
# (campaigns, prospects, decisions, approvals, agents, agent_versions, agent_overrides, channels,
# suppression, integrations, events, app_settings) become the source of truth. Leave blank to
# keep the zero-setup local JSON file mode.
DATABASE_URL=

# Agent engine: "rule" (default, zero cost, zero setup, deterministic heuristics)
# or "llm" (real Anthropic API calls per PS Section 4 — requires ANTHROPIC_API_KEY below)
# or "dronahq" (the DronaHQ Agentic AI agents, called through their Webhook Triggers — see below)
# or "gemini" (Google Gemini, free tier — see below)
# or a CHAIN tried in order, for example "dronahq,gemini". The rule engine is always the last resort.
AGENT_ENGINE=rule

# Only read when "gemini" is in AGENT_ENGINE. Get a free key from Google AI Studio and put it ONLY in
# your private .env (never in chat, never committed).
GEMINI_API_KEY=
# Google retires models often. If you get "no longer available" (HTTP 404), list what your key can use with
#   node backend\scripts\gemini-models.mjs
# and put a current Flash model here.
# One model, or several separated by commas, first choice first. Free-tier quotas are PER MODEL, so a second
# model keeps things running when the first one's quota is used up. The lite model is ~4x faster.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash
# Client-side throttle. The free tier allows roughly 15 requests/minute, so stay under it.
GEMINI_RPM=12
GEMINI_TIMEOUT_MS=30000
# "rule": on failure move to the next engine. "none": rethrow, so failures are visible.
GEMINI_FALLBACK=rule

# Only read when "dronahq" is in AGENT_ENGINE. One Webhook Trigger URL per agent (Agent -> Triggers -> Webhook)
# and that trigger's API key (sent in the `api-key` header).
# KNOWN ISSUE: in testing, the webhook reply did not carry the agent's output (Response=Standard gave
# `response: null`; None gave "started in background"), although the run's trace shows the right JSON was
# produced. Until that is solved, use the chain "dronahq,gemini" so Gemini decides.
DRONAHQ_WEBHOOK_ICP=
DRONAHQ_API_KEY_ICP=
DRONAHQ_WEBHOOK_PERSONALISATION=
DRONAHQ_API_KEY_PERSONALISATION=
DRONAHQ_WEBHOOK_CONVERSATION=
DRONAHQ_API_KEY_CONVERSATION=
# Used for any agent that has no key of its own above.
DRONAHQ_API_KEY=
# The docs give no timeout, so this is generous. Milliseconds.
DRONAHQ_TIMEOUT_MS=90000
# "rule": if a DronaHQ call fails, fall back to the rule engine for that decision.
# "none": rethrow instead, so failures are visible while you integrate.
DRONAHQ_FALLBACK=rule

# Only read when AGENT_ENGINE=llm.
ANTHROPIC_API_KEY=
# Cheaper/faster model for high-volume, low-stakes calls (Lead Research, ICP Fitment).
AGENT_MODEL_FAST=claude-3-5-haiku-latest
# Stronger model for customer-facing drafting and conversation handling
# (Personalisation & Outreach Strategy, Conversation & Follow-up, Voice SDR).
AGENT_MODEL_SMART=claude-sonnet-4-5
# Check https://docs.claude.com/en/docs/about-claude/models for current model IDs
# if either default above has been retired.

# How often the autonomous scheduler advances Live campaigns (milliseconds).
SCHEDULER_INTERVAL_MS=12000
# Max prospects advanced per campaign per scheduler tick.
SCHEDULER_BATCH_SIZE=3

# ---- Cost and quota control -------------------------------------------------------------------
# Hard daily cap on LLM requests (retries count). Past it, the rule engine decides, so the free quota
# can never be burned dry. 0 = no cap. Counts persist in data/usage.json, so a restart does not reset it.
LLM_DAILY_CALL_CAP=300
# Clear-cut ICP rejections (rule score this far below the campaign threshold) skip the LLM; qualifications always
# get the LLM's read. 0 = always ask the LLM.
ICP_SHORTCUT_MARGIN=20
# Route unsubscribe / hostile / out-of-office replies by embedding similarity, no LLM call. "off" to disable.
REPLY_ROUTING=on
# Similarity needed, and how far ahead of the nearest "needs judgment" category (0..1).
REPLY_MIN_SCORE=0.80
REPLY_MIN_MARGIN=0.05
# Only used for the "cost saved" figure on the dashboard.
EST_COST_PER_LLM_CALL=0.0015
