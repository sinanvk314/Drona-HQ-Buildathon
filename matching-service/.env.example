# Copy this to .env and fill in real values. Never commit .env itself.

# Same Neon connection string Dev 1 uses for campaigns/prospects.
DATABASE_URL=postgresql://user:password@host/dbname

# Embeddings run 100% locally via fastembed — no API key, no billing.
# First call downloads the model (~130MB) from huggingface.co and caches
# it; every call after that is offline. Tests in tests/test_similarity.py
# and tests/test_services_with_mock.py run fine without any of this too —
# they use embed_text_mock() instead.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Tunable thresholds — defaults are reasonable starting points, re-tune
# once you see real score distributions from your actual data.
TRIAGE_TOP_N_DEFAULT=25
CONTACT_MATCH_MIN_SCORE=0.55
REPLY_HIGH_CONFIDENCE_SCORE=0.80
