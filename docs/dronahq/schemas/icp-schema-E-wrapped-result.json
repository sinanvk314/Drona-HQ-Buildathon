{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICP Fitment Result",
  "type": "object",
  "description": "The ICP Fitment decision, under the key `result` (the agent's Structured Output name).",
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "type": "object",
      "required": [
        "agent_name",
        "decision",
        "qualified",
        "fit_score",
        "score",
        "reasoning",
        "evidence",
        "conflict_check",
        "final_action",
        "handoff_note"
      ],
      "properties": {
        "agent_name": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "qualified": {
          "type": "string"
        },
        "fit_score": {
          "type": "string"
        },
        "score": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "conflict_check": {
          "type": "string"
        },
        "final_action": {
          "type": "string"
        },
        "handoff_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
